# Terraform working directories and dependency cache
**/.terraform/*

# Terraform state, plans, crash logs, and generated command output
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
tfplan
tfplan.*
tfplan-*
.terraform-plan.log
terraform.log
*.log
crash.log
crash.*.log

# This repository follows the existing MoneyYu course-repo convention and
# regenerates the provider lock file locally.
**/.terraform.lock.hcl

# Local Terraform values and overrides can contain credentials or tenant data.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI, environment, and secret-bearing configuration
.terraformrc
terraform.rc
.env
.env.*
!.env.example
.mcp.json
*.pfx
*.p12
*.pem
*.key

# Generated SQL project build and restore outputs
DEMO/M07/common/Dp800.Database/bin/
DEMO/M07/common/Dp800.Database/obj/
